{
  "expo": {
    "name": "LumaChat Premium",
    "slug": "premium-offline-chat",
    "scheme": "lumachat",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-notifications"
    ],
    "android": {
